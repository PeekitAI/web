# Kubernetes Configuration
# The namespace where all resources are managed (jobs, cronjobs, templates, configmaps, secrets)
NAMESPACE=peekit-crawlers

# By default, the Kubernetes client will use:
# - In-cluster config if running in a pod
# - ~/.kube/config if running locally
# You can override with KUBECONFIG environment variable
# KUBECONFIG=/path/to/your/kubeconfig
